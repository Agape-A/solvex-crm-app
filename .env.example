# Copia questo file in ".env" e riempi i valori.
# Li trovi in Supabase → Project Settings → API, dopo aver creato il progetto.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Notifiche push (opzionale — vedi README, sezione "Notifiche push"):
# chiave pubblica VAPID, non segreta (la segreta va solo nella Edge Function).
VITE_VAPID_PUBLIC_KEY=
